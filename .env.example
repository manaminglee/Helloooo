# Helloooo / ManaMingle — server env template
# Copy to `.env` locally. Never commit real secrets.

NODE_ENV=development
PORT=3000
ADMIN_KEY=
FRONTEND_ORIGIN=http://localhost:5173

# Optional Redis (matchmaking + Socket.IO adapter)
# REDIS_URL=

# Optional TURN (1:1 mesh / mesh fallback)
# TURN_URL + TURN_USERNAME + TURN_PASSWORD describe ONE operator-owned TURN
# service. These credentials are only ever paired with TURN_URL's own host —
# never with the shared relay hosts below (wrong-host creds cause 401s that
# show up to users as a stuck "connecting" screen).
# Prefer a bare host (e.g. `free.expressturn.com`) over a full URL: the server
# then emits UDP + TCP + TLS variants, so UDP-blocked networks still connect.
# TURN_USERNAME=
# TURN_PASSWORD=
# TURN_URL=

# Shared regional relay fallback (Metered-style hosts). These carry their OWN
# credentials, set below. Set TURN_DISABLE_FALLBACK=1 to use only your own TURN.
# TURN_FALLBACK_USERNAME=
# TURN_FALLBACK_PASSWORD=
# TURN_DISABLE_FALLBACK=
# TURN_HOST_IN=
# TURN_HOST_UK=
# TURN_HOST_EU=
# TURN_HOST_US=
# TURN_HOST_GLOBAL=

# LiveKit SFU — group video (required for Selective Forwarding)
# Create a project at https://cloud.livekit.io (or self-host)
# 

# Live gift split (creator share 0..1). Default 0.7
# LIVE_GIFT_CREATOR_SHARE=0.7

