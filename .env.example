# =============================================================================
# Mana-Mingle – Environment variables
# =============================================================================
# Copy to .env and fill in values. Never commit .env to git.
# =============================================================================

# --- Server ---
PORT=3000
NODE_ENV=development

# --- Security ---
ADMIN_KEY=

# --- CORS (production: comma-separated origins) ---
FRONTEND_ORIGIN=http://localhost:5173

# --- Client (Vite build) ---
VITE_SOCKET_URL=http://localhost:3000
VITE_TURNSTILE_SITE_KEY=

# --- WebRTC TURN (strongly recommended for video behind NAT) ---
# Without these, the server falls back to public Metered relay (dev only).
TURN_URL=turn:global.relay.metered.ca:443
TURN_USERNAME=
TURN_PASSWORD=

# --- Supabase (coins, creators, optional trust/reports/pro tables) ---
SUPABASE_URL=https://yourproject.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional Supabase tables (graceful fallback to data/manadb.json if missing):
# mm_trust_scores (ip_hash, score, sessions, badges, reports, updated_at)
# mm_reports (id, reporter_ip, target_ip, reason, created_at)
# mm_conversation_ratings (rater_ip, target_ip, rating, room_id, created_at)
# mm_pro_users (ip, is_pro, pro_until, updated_at)

# --- NVIDIA AI ---
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama3-70b-instruct
NVIDIA_FAST_MODEL=mistralai/mistral-7b-instruct-v0.1

# --- Pro subscription ---
# Comma-separated access codes for /api/pro/activate
PRO_ACCESS_CODES=MANAMINGLE-PRO-2026

# --- Payments (Stripe / Razorpay / test mode) ---
# Provider: auto | stripe | razorpay | test
PAYMENT_PROVIDER=auto
# Simulated checkout when no keys (recommended for local dev)
PAYMENT_TEST_MODE=true

# Stripe test keys: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_
STRIPE_PUBLISHABLE_KEY=pk_test_

# Razorpay test keys: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_
RAZORPAY_KEY_SECRET=

# Optional price overrides (cents / paise)
# PAYMENT_PRO_USD_CENTS=499
# PAYMENT_PRO_INR_PAISE=39900
# PAYMENT_UNBLOCK_USD_CENTS=500
# PAYMENT_UNBLOCK_INR_PAISE=41500

# Legacy static checkout links (fallback when no API keys)
STRIPE_PRO_URL=
STRIPE_UNBLOCK_URL=

# --- Session ---
RECONNECT_TTL_MS=180000

# --- Optional ---
# DOTENV_CONFIG_PATH=/absolute/path/to/.env
