# ManaMingle server environment template.
# Copy to `.env` and fill in real values. NEVER commit `.env` — only this file.
# All values here are placeholders, not real credentials.

# --- Core ---
# Port the Express + Socket.IO server listens on. Default: 3000
PORT=3000
# development | production. In production, security checks fail closed.
NODE_ENV=development
# Strong random secret (min 16 chars) protecting the admin panel & admin socket
# events. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_KEY=change-me-to-a-long-random-string
# Public origin(s) of the frontend, comma-separated. Used for CORS, payment
# redirect URLs, and creator emails.
FRONTEND_ORIGIN=http://localhost:5173
# Optional override path for the dotenv file (defaults to ./.env).
# DOTENV_CONFIG_PATH=

# --- Supabase (optional; falls back to local JSON at server/data/manadb.json) ---
SUPABASE_URL=
# Service role key bypasses RLS for server-side admin operations (preferred).
SUPABASE_SERVICE_ROLE_KEY=
# Anon key is used only as a fallback when no service role key is set.
SUPABASE_ANON_KEY=

# --- Cloudflare Turnstile (bot protection) ---
# If unset: production returns 503 on /api/verify-turnstile; development logs a
# warning and bypasses verification.
TURNSTILE_SECRET_KEY=

# --- WebRTC TURN relay (optional; STUN-only without these) ---
TURN_URL=
TURN_USERNAME=
TURN_PASSWORD=

# --- Payments (Stripe / Razorpay / explicit test mode) ---
# auto | stripe | razorpay | test
PAYMENT_PROVIDER=auto
# Test mode must be enabled EXPLICITLY (never auto-derived from NODE_ENV).
PAYMENT_TEST_MODE=false
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Optional hosted Stripe Payment Links (used when no API keys are configured).
STRIPE_PRO_URL=
STRIPE_UNBLOCK_URL=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Price overrides (defaults: pro $4.99 / ₹399, unblock $5.00 / ₹415).
PAYMENT_PRO_USD_CENTS=499
PAYMENT_PRO_INR_PAISE=39900
PAYMENT_UNBLOCK_USD_CENTS=500
PAYMENT_UNBLOCK_INR_PAISE=41500
# Comma-separated one-time Pro access codes (redeemed via /api/pro/activate).
PRO_ACCESS_CODES=

# --- NVIDIA NIM AI (icebreakers, moderation, copilot) ---
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama3-70b-instruct
NVIDIA_FAST_MODEL=mistralai/mistral-7b-instruct-v0.1
# Outbound AI call timeout in ms (default 10000) so moderation can't hang chat.
NVIDIA_TIMEOUT_MS=10000

# --- Creator program email (SMTP or Resend; optional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Alias accepted for SMTP_PASS:
# SMTP_PASSWORD=
RESEND_API_KEY=
EMAIL_FROM=ManaMingle Creators <noreply@example.com>
# Mailbox that receives new-application / support notifications.
CREATOR_ADMIN_EMAIL=
SUPPORT_EMAIL=
# true = log emails to the server console instead of sending them.
EMAIL_TEST_MODE=true
# Canonical frontend URL used inside emails (falls back to FRONTEND_ORIGIN).
FRONTEND_URL=

# --- Misc ---
# Reconnect-token lifetime in ms (default 180000).
RECONNECT_TTL_MS=180000
