# Helloooo / ManaMingle — server env template
# Copy to `.env` locally. Never commit real secrets.

NODE_ENV=development
PORT=3000
ADMIN_KEY=
FRONTEND_ORIGIN=http://localhost:5173

# Agency dashboard (/agency). Sent by the client as the `x-agency-key` header.
#
# This is the PLATFORM OPERATOR key: it sees every agency and keeps the
# platform-wide levers (global settings, minting Nuts into any wallet, the
# shared audio rooms). Falls back to ADMIN_KEY when unset; with neither key set
# the agency API answers 503 and the panel stays closed. Use a separate value
# from ADMIN_KEY so agency staff never hold full admin rights.
# AGENCY_ADMIN_KEY=
#
# Individual agencies do NOT use this key. Create them in the admin panel
# (Agencies tab) or via POST /api/admin/agencies; each one gets its own
# `agk_…` key plus an owner email/password login, and can only ever see its own
# roster, invites, mint pool and commissions. Run
# supabase_migration_agency_v1.sql first if Supabase is configured.

# Optional Redis (matchmaking + Socket.IO adapter)
# REDIS_URL=

# Optional TURN (1:1 mesh / mesh fallback)
# TURN_URL + TURN_USERNAME + TURN_PASSWORD describe ONE operator-owned TURN
# service. These credentials are only ever paired with TURN_URL's own host —
# never with the shared relay hosts below (wrong-host creds cause 401s that
# show up to users as a stuck "connecting" screen).
# Prefer a bare host (e.g. `free.expressturn.com`) over a full URL: the server
# then emits UDP + TCP + TLS variants, so UDP-blocked networks still connect.
# TURN_USERNAME=
# TURN_PASSWORD=
# TURN_URL=

# Shared regional relay fallback (Metered-style hosts). These carry their OWN
# credentials, set below. Set TURN_DISABLE_FALLBACK=1 to use only your own TURN.
# TURN_FALLBACK_USERNAME=
# TURN_FALLBACK_PASSWORD=
# TURN_DISABLE_FALLBACK=
# TURN_HOST_IN=
# TURN_HOST_UK=
# TURN_HOST_EU=
# TURN_HOST_US=
# TURN_HOST_GLOBAL=

# LiveKit SFU — group video + lives (required for Selective Forwarding).
# Also required for HP battle split-screen, which opens a second watch-only
# connection to the opponent's room.
# Create a project at https://cloud.livekit.io (or self-host)
# LIVEKIT_URL=wss://xxx.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# LIVEKIT_ROOM_PREFIX=helloooo

# Supabase — persistence. Without these the server falls back to local JSON
# storage and data resets on restart.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Live gift split (creator share 0..1). Default 0.7
# The remainder is the platform cut, which is also what funds agency
# commission — an agency creator's take-home is unchanged by their agency.
# LIVE_GIFT_CREATOR_SHARE=0.7

# Point the local JSON fallback DB at another directory. Used by the agency
# HTTP test so a test run never touches server/data/manadb.json.
# LOCAL_DB_DIR=

