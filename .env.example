# Helloooo / ManaMingle — server env template
# Copy to `.env` locally. Never commit real secrets.

NODE_ENV=development
PORT=3000
ADMIN_KEY=
FRONTEND_ORIGIN=http://localhost:5173

# Optional Redis (matchmaking + Socket.IO adapter)
# REDIS_URL=

# Optional TURN (1:1 mesh / mesh fallback)
# TURN_USERNAME=
# TURN_PASSWORD=
# TURN_URL=
# TURN_HOST_IN=
# TURN_HOST_UK=
# TURN_HOST_EU=
# TURN_HOST_US=
# TURN_HOST_GLOBAL=

